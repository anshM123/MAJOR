\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The two chiral surfaces $X_L$, $X_R$ of a rotating three-boundary wormhole (pairs of pants; shaded annuli are funnels, dashed circles horizons, thick circles conformal boundaries). The region $A$ (blue) is an interval $[p,p']$ of boundary~1 together with all of boundary~2. One cut class $c$ (red), an arc from $p$ to $p'$ around funnel~2, has different lengths on the two surfaces; the HRT curve of class $c$ has length $\frac  12[\ell _L(c)+\ell _R(c)]$, and the minimum is taken over classes common to both surfaces.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:wormhole}{{1}{2}{The two chiral surfaces $X_L$, $X_R$ of a rotating three-boundary wormhole (pairs of pants; shaded annuli are funnels, dashed circles horizons, thick circles conformal boundaries). The region $A$ (blue) is an interval $[p,p']$ of boundary~1 together with all of boundary~2. One cut class $c$ (red), an arc from $p$ to $p'$ around funnel~2, has different lengths on the two surfaces; the HRT curve of class $c$ has length $\frac 12[\ell _L(c)+\ell _R(c)]$, and the minimum is taken over classes common to both surfaces}{figure.1}{}}
